FROM node:22-bookworm-slim AS languages
RUN npm install --prefix /opt/lsp --omit=dev pyright@1.1.414

FROM fjord:local
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libstdc++6 libatomic1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=languages /usr/local/bin/node /opt/lsp/node
COPY --from=languages /opt/lsp/node_modules /opt/lsp/node_modules
USER 10001:10001
